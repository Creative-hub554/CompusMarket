# Copy this file to docker/.env and set strong, unique values.
# docker compose automatically loads docker/.env when present.
#
# The MinIO root user/password map to the backend's MINIO_ACCESS_KEY / MINIO_SECRET_KEY,
# so set MINIO_ROOT_USER / MINIO_ROOT_PASSWORD to match the backend .env.

POSTGRES_PASSWORD=change_me_strong_password
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
MEILI_MASTER_KEY=change_me_strong_master_key

# ---- App services (compose.prod.yml) ----
MINIO_BUCKET=khmeronlineshopbytheo
AUTH_SECRET=change_me_strong_auth_secret
JWT_SECRET=change_me_strong_jwt_secret
CORS_ORIGIN=https://www.champey.com,https://admin.champey.com
NEXT_PUBLIC_API_URL=https://www.champey.com/api
NEXT_PUBLIC_SITE_URL=https://www.champey.com
HTTP_PORT=80
# Enabled only when HTTPS certificates are mounted (see docker/nginx/ssl/*.sh).
HTTPS_PORT=443
# Shared secret Prometheus uses to scrape the backend /api/metrics endpoint.
# Must equal the backend's METRICS_TOKEN. Change from the default in production.
METRICS_TOKEN=metrics-token-change-me

# ---- Monitoring (--profile monitoring) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_grafana_pw
# Grafana alerting destination. Set at least one:
OPS_EMAIL=ops@example.com
OPS_WEBHOOK_URL=

# ---- Backup (--profile backup) ----
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=7

# ---- Error tracking (Sentry) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
