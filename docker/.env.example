# Copy this file to docker/.env and set strong, unique values.
# docker compose automatically loads docker/.env when present.
#
# The MinIO root user/password map to the backend's MINIO_ACCESS_KEY / MINIO_SECRET_KEY,
# so set MINIO_ROOT_USER / MINIO_ROOT_PASSWORD to match the backend .env.

POSTGRES_PASSWORD=change_me_strong_password
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
MEILI_MASTER_KEY=change_me_strong_master_key
