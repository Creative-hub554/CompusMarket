[TEMPLATE]
# ── Clerk authentication (required) ──────────────────────────────────────────
# Same Clerk instance as the storefront. Admins are ordinary Clerk users whose
# local DB role is ADMIN or CONTENT_EDITOR (authorization stays DB-first).
# Copy to .env.local (gitignored) with real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Backend API ─────────────────────────────────────────────────────────────
# Browser-facing base URL (local dev). Inside docker compose, set
# INTERNAL_API_URL to the backend service name instead.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-to-server origin for backend calls (docker service name in compose).
INTERNAL_API_URL=http://localhost:4000
# Shared secret guarding internal relay endpoints (notification push, product
# writes, etc.). Must match the backend's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=