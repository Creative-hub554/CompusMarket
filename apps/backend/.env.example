# Backend configuration for local development.
# Copy this file to apps/backend/.env and fill in the values.
#
# For the embedded preview stack, point DATABASE_URL at the local embedded
# Postgres started by start-preview.ps1 (see scripts/pg-launcher.cjs).
DATABASE_URL=postgresql://theo:changeme@localhost:5432/theo_platform

# HTTP port for the NestJS backend
PORT=4000

# Comma-separated CORS origins the backend will accept
CORS_ORIGIN=http://localhost:3000
