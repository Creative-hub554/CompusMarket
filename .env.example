# Database Configuration
DB_USER=theo
DB_PASSWORD=theo_secure_password
DB_NAME=khmeronlineshop
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khmeronlineshop

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# MinIO S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:4000

# Champey Assistant (OpenHands SDK service) — the chat widget calls this.
# Defaults to http://localhost:8001 when unset.
NEXT_PUBLIC_ASSISTANT_URL=http://localhost:8001

# Server-to-server calls (admin → backend socket relay, Clerk-dashboard ban
# alerts). INTERNAL_API_URL is the backend origin as seen from the calling
# container/process (inside compose: http://backend:4000); the token guards
# the backend /internal/* endpoints — keep it in sync across services.
INTERNAL_SERVICE_TOKEN=
INTERNAL_API_URL=http://localhost:4000

# OpenAI Integration (optional)
OPENAI_API_KEY=

# Node Environment
NODE_ENV=production

# Redis
REDIS_URL=redis://redis:6379

# SMTP (optional — enables real password-reset / email-verification delivery.
# Without it the app stays fully testable: auth endpoints return the magic
# links directly in the response as devUrl links.)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="Champey <no-reply@example.com>"
