# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"

# Auth (NextAuth v4)
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# JWT (Backend)
JWT_SECRET="your-jwt-secret-here"

# Backend
PORT=4000

# CORS allow-list (comma-separated origins; falls back to localhost dev ports)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Admin seed script (apps/backend/create-user.js)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET="khmeronlineshopbytheo"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# OpenRouter (optional; preferred over OPENAI_API_KEY when set)
OPENROUTER_API_KEY="sk-or-..."
# Free open-source models work too, e.g. "dots-studio/dots-3-note-preview:free", "z-ai/glm-5.2:free", "google/gemma-4-26b-a4b-it:free"
AI_MODEL="openai/gpt-4o-mini"
# Optional comma-separated fallback models tried when the primary is rate-limited or fails
AI_FALLBACK_MODELS="z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free"
AI_BASE_URL="https://openrouter.ai/api/v1"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILI_HOST="http://localhost:7700"
MEILI_API_KEY="masterKey"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Public site URL used for SEO metadata, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
